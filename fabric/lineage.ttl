@prefix ob: <https://manvith-d.github.io/ontobridge/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://manvith-d.github.io/ontobridge/id/dsd/finance.fact_card_transactions> a qb:DataStructureDefinition ;
    rdfs:label "finance.fact_card_transactions" ;
    qb:component [ qb:dimension ob:currencyCode ],
        [ qb:dimension ob:customerId ],
        [ qb:dimension ob:merchantName ],
        [ qb:dimension ob:fraudFlag ],
        [ qb:measure ob:transactionAmount ],
        [ qb:dimension ob:cardLast4 ],
        [ qb:dimension ob:countryCode ],
        [ qb:dimension ob:cardTransactionId ],
        [ qb:dimension ob:city ],
        [ qb:dimension ob:authorizationTimestamp ] .

<https://manvith-d.github.io/ontobridge/id/dsd/finance.fact_ledger_entries> a qb:DataStructureDefinition ;
    rdfs:label "finance.fact_ledger_entries" ;
    qb:component [ qb:dimension ob:journalEntryId ],
        [ qb:dimension ob:accountNumber ],
        [ qb:dimension ob:postingDate ],
        [ qb:measure ob:creditAmount ],
        [ qb:measure ob:debitAmount ],
        [ qb:dimension ob:currencyCode ] .

<https://manvith-d.github.io/ontobridge/id/dsd/healthcare.fact_ehr_encounters> a qb:DataStructureDefinition ;
    rdfs:label "healthcare.fact_ehr_encounters" ;
    qb:component [ qb:dimension ob:providerNpi ],
        [ qb:dimension ob:admitDate ],
        [ qb:measure ob:totalCharges ],
        [ qb:dimension ob:stateCode ],
        [ qb:dimension ob:patientMrn ],
        [ qb:dimension ob:facilityCode ],
        [ qb:dimension ob:encounterType ],
        [ qb:dimension ob:dischargeDate ],
        [ qb:dimension ob:encounterId ],
        [ qb:dimension ob:primaryDiagnosisCode ] .

<https://manvith-d.github.io/ontobridge/id/dsd/healthcare.fact_pharmacy_fills> a qb:DataStructureDefinition ;
    rdfs:label "healthcare.fact_pharmacy_fills" ;
    qb:component [ qb:dimension ob:prescriptionId ],
        [ qb:dimension ob:providerNpi ],
        [ qb:measure ob:quantityDispensed ],
        [ qb:dimension ob:fillDate ],
        [ qb:measure ob:daysSupply ],
        [ qb:measure ob:copayAmount ],
        [ qb:dimension ob:patientMrn ],
        [ qb:dimension ob:ndcCode ] .

<https://manvith-d.github.io/ontobridge/id/dsd/insurance.fact_claims_events> a qb:DataStructureDefinition ;
    rdfs:label "insurance.fact_claims_events" ;
    qb:component [ qb:dimension ob:lossCause ],
        [ qb:dimension ob:postalCode ],
        [ qb:measure ob:reserveAmount ],
        [ qb:measure ob:paidAmount ],
        [ qb:dimension ob:claimStatus ],
        [ qb:dimension ob:customerId ],
        [ qb:dimension ob:claimId ],
        [ qb:dimension ob:policyNumber ],
        [ qb:dimension ob:lossDate ],
        [ qb:dimension ob:stateCode ],
        [ qb:dimension ob:claimReportedTimestamp ] .

<https://manvith-d.github.io/ontobridge/id/dsd/insurance.fact_policy_admin> a qb:DataStructureDefinition ;
    rdfs:label "insurance.fact_policy_admin" ;
    qb:component [ qb:dimension ob:agentId ],
        [ qb:dimension ob:policyExpirationDate ],
        [ qb:dimension ob:customerId ],
        [ qb:dimension ob:policyEffectiveDate ],
        [ qb:dimension ob:policyNumber ],
        [ qb:measure ob:premiumAmount ],
        [ qb:dimension ob:stateCode ] .

<https://manvith-d.github.io/ontobridge/id/dsd/retail.fact_ecommerce_orders> a qb:DataStructureDefinition ;
    rdfs:label "retail.fact_ecommerce_orders" ;
    qb:component [ qb:dimension ob:orderTimestamp ],
        [ qb:measure ob:orderSubtotal ],
        [ qb:dimension ob:customerId ],
        [ qb:dimension ob:salesChannel ],
        [ qb:dimension ob:countryCode ],
        [ qb:dimension ob:postalCode ],
        [ qb:measure ob:shippingFee ],
        [ qb:dimension ob:orderId ] .

<https://manvith-d.github.io/ontobridge/id/dsd/retail.fact_pos_sales> a qb:DataStructureDefinition ;
    rdfs:label "retail.fact_pos_sales" ;
    qb:component [ qb:dimension ob:transactionId ],
        [ qb:dimension ob:storeId ],
        [ qb:dimension ob:saleTimestamp ],
        [ qb:measure ob:quantity ],
        [ qb:measure ob:unitPrice ],
        [ qb:dimension ob:customerId ],
        [ qb:measure ob:discountAmount ],
        [ qb:dimension ob:productSku ] .

